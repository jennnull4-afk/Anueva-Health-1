# Server-side PrymaLab credentials and endpoint. Never prefix with NEXT_PUBLIC_.
PRYMALAB_API_KEY=
PRYMALAB_WEBHOOK_SECRET=
PRYMALAB_API_BASE_URL=https://prymalab.net/wp-json/prymalab/v1

# Required for persistent order and webhook data on Vercel. Create a Redis
# database through the Upstash Vercel integration and copy these values.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Required for the COA staff area. Use a high-entropy secret managed only in
# Vercel; it signs the httpOnly staff-session cookie and is never public.
AUNEVA_COA_ADMIN_TOKEN=

# Required for private PDF storage in Vercel. Create a private Vercel Blob
# store and connect it to the project so Vercel supplies this credential.
BLOB_READ_WRITE_TOKEN=

# Optional future support-mail integration. COA requests are stored internally
# today; no outbound email is sent until a provider is configured.
AUNEVA_COA_SUPPORT_EMAIL=

# Optional public canonical URL for metadata, sitemap, and robots.txt.
AUNEVA_SITE_URL=https://aunevaresearch.com